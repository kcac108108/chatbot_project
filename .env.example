# Oracle DB (로컬 dev — 더미 데이터 전용, 기존 oracle-xe 컨테이너 공유)
ORACLE_USER=CHATBOT
ORACLE_PASSWORD=Chatbot1234
ORACLE_DSN=127.0.0.1:1521/xepdb1

# Oracle DB (운영) — 배포 시 실제 값으로 교체, 여기에 채우지 말 것
#ORACLE_USER=
#ORACLE_PASSWORD=
#ORACLE_DSN=

# Qdrant
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=history_chatbot

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o-mini

# 사내망 TLS 인터셉션(MonitorApp) 대응 — 개발 PC 전용, 운영에선 불필요할 수 있음
SSL_CERT_FILE=./combined_ca_bundle.pem
REQUESTS_CA_BUNDLE=./combined_ca_bundle.pem

# 2단계: 첨부파일 실물이 있는 경로 — DOCUCD별 하위폴더(C0002010~C0002014)를 담은 루트.
# 배포 시 운영 서버의 실제 첨부파일 반입 경로로 교체
ATTACHMENT_BASE_DIR=

# 신규 이력 첨부파일 자동처리(2026-09-29) — 전산팀 OCR 서버 연동.
# SFTP 계정 정보는 전산팀 호환성 조사 완료 후 채울 것(현재 미확정).
OCR_SFTP_HOST=
OCR_SFTP_PORT=22
OCR_SFTP_USER=
OCR_SFTP_PASSWORD=
# 개발 기간 한정 외부망 주소(기본값). 운영 배포 시 내부망 주소로 교체:
# OCR_API_BASE_URL=http://193.1.2.43:9091
OCR_API_BASE_URL=https://ai.bandtrass.or.kr:9091
OCR_REMOTE_PDF_DIR=/DATA/backend/rag/data
OCR_REMOTE_IMAGE_DIR=/DATA/backend/rag/data/images
OCR_REMOTE_TEXT_DIR=/DATA/backend/rag/data/pdfToText