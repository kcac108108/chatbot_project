# Oracle DB (로컬 dev — 더미 데이터 전용, 기존 oracle-xe 컨테이너 공유)
ORACLE_USER=CHATBOT
ORACLE_PASSWORD=Chatbot1234
ORACLE_DSN=127.0.0.1:1521/xepdb1

# Oracle DB (운영) — 배포 시 실제 값으로 교체, 여기에 채우지 말 것
#ORACLE_USER=
#ORACLE_PASSWORD=
#ORACLE_DSN=

# 운영 DB는 이력관리시스템 원본 테이블을 DB링크(@STATWEB) 경유로 조회한다(정의서 1.2절).
# 이 개발 PC(로컬 DB)는 링크 없이 동일 테이블명으로 구성돼 있어 비워둔다.
# 운영 배포 시 반드시 DB_TABLE_SUFFIX=@STATWEB 로 설정할 것 — 안 하면 테이블을 못 찾는다.
DB_TABLE_SUFFIX=

# Qdrant
# 로컬 dev: 앱이 컨테이너 밖(venv)에서 직접 돌아가 localhost로 접근 가능.
# 운영: 앱도 docker-compose로 컨테이너로 뜨므로 Qdrant 컨테이너를 서비스명으로 찾아야 함
# — 반드시 QDRANT_HOST=qdrant 로 교체할 것(localhost로 두면 앱이 자기 자신을 가리켜 연결 실패).
QDRANT_HOST=localhost
QDRANT_PORT=6333
QDRANT_COLLECTION=history_chatbot

# OpenAI
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large
OPENAI_CHAT_MODEL=gpt-4o-mini

# 사내망 TLS 인터셉션(MonitorApp) 대응 — 개발 PC 전용, 운영에선 불필요할 수 있음
SSL_CERT_FILE=./combined_ca_bundle.pem
REQUESTS_CA_BUNDLE=./combined_ca_bundle.pem

# 2단계: 첨부파일 실물이 있는 경로 — DOCUCD별 하위폴더(C0002010~C0002014)를 담은 루트.
# 배포 시 운영 서버의 실제 첨부파일 반입 경로로 교체. 전산팀이 매일 새벽 배치로 생성하는
# OCR 결과(.txt)도 원본과 같은 경로·파일명(확장자만 .txt)으로 이 트리 안에 그대로 생기므로
# (2026-10-12 설계 확정) 별도 OCR 연동 설정은 필요 없다.
ATTACHMENT_BASE_DIR=

# 챗봇 검색 설정
CHAT_TOP_K=6
CHAT_REQUEST_TIMEOUT_SECONDS=45